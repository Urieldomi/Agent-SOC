[Unit]
Description=Agent SOC local Ollama runtime
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/ccomputo/projects/Agent-SOC
Environment=OLLAMA_HOST=127.0.0.1:11434
Environment=OLLAMA_MODELS=/home/ccomputo/projects/Agent-SOC/.runtime/models
Environment=OLLAMA_KEEP_ALIVE=10m
ExecStart=/home/ccomputo/projects/Agent-SOC/.runtime/ollama/bin/ollama serve
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
