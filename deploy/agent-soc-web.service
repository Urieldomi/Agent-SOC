[Unit]
Description=Agent SOC web application
Wants=network-online.target
After=network-online.target agent-soc-ollama.service

[Service]
Type=simple
WorkingDirectory=/home/ccomputo/projects/Agent-SOC
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ccomputo/projects/Agent-SOC/.venv/bin/gunicorn app:app --bind 127.0.0.1:5055 --workers 1 --timeout 60 --access-logfile - --error-logfile -
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
